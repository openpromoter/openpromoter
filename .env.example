# Required
DATABASE_URL=postgres://openpromoter:openpromoter@localhost:5432/openpromoter
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-to-32-random-characters
ENCRYPTION_KEY=change-me-to-32-random-characters

# Sign in with Google and GitHub (optional; each button shows only when both of its values are set)
# Callback URLs: {APP_URL}/api/auth/callback/google and {APP_URL}/api/auth/callback/github
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Email (pick one; without either, emails are logged, not sent)
SMTP_URL=smtp://localhost:1025
# RESEND_API_KEY=re_...
EMAIL_FROM=OpenPromoter <hello@yourdomain.com>

# AI (optional; every feature works without it in a reduced form)
# ANTHROPIC_API_KEY=sk-ant-...
# Leave AI_MODEL unset with Anthropic: each feature picks Haiku, Sonnet or Opus by itself.
# Setting it forces one model for every feature.
# AI_MODEL=claude-sonnet-5-5
# Or any OpenAI-compatible endpoint (OpenAI, Ollama, LM Studio):
# AI_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1

# Cloud edition only
HOSTED_MODE=false
# STRIPE_CONNECT_CLIENT_ID=ca_...
# PLATFORM_STRIPE_SECRET_KEY=sk_...
# PLATFORM_STRIPE_WEBHOOK_SECRET=whsec_...

# Custom domains with automatic HTTPS (Cloudflare for SaaS). Unset: founders CNAME to the APP_URL host
# and your reverse proxy (Caddy, Traefik) issues the certificates.
# Token needs Zone > SSL and Certificates > Edit on the zone below.
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ZONE_ID=...
# CUSTOM_DOMAIN_TARGET=domains.openpromoter.com

# Run the background worker in this process (default true)
RUN_WORKER=true
# docker compose: create the demo workspace on first boot
SEED_DEMO=true

# Database connections per app process (default 10). Replicas × pool must stay under Postgres max_connections.
# DATABASE_POOL_MAX=10

# Rate limits are shared through Postgres so several replicas enforce one limit (default).
# Set to memory for a single instance that should not write counters to the database.
# RATE_LIMIT_STORE=postgres

# Client IP for rate limits and fraud signals. Behind Cloudflare use cf-connecting-ip, on Fly fly-client-ip.
# Unset: the last X-Forwarded-For entry (the one your reverse proxy adds). Without any proxy in front,
# clients can spoof forwarding headers, so put OpenPromoter behind one in production.
# TRUSTED_IP_HEADER=cf-connecting-ip
