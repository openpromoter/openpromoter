{
  "name": "openpromoter",
  "version": "0.1.1",
  "description": "TypeScript SDK for OpenPromoter, the open-source affiliate and referral platform",
  "keywords": [
    "affiliate",
    "referral",
    "partners",
    "stripe",
    "openpromoter"
  ],
  "homepage": "https://openpromoter.com",
  "bugs": {
    "url": "https://github.com/openpromoter/openpromoter/issues"
  },
  "author": "DevDiggers (https://devdiggers.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openpromoter/openpromoter.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=18"
  }
}
